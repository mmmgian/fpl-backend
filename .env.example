LEAGUE_ID=467763
DB_PATH=snapshots.db
# Comma-separated; use your Vercel URL in production
ALLOWED_ORIGINS=*
# If set, the frontend cron must send X-Snapshot-Secret with the same value
SNAPSHOT_SECRET=
# 1 (default): rebuild missing history from FPL after a restart wipes the disk. 0 turns it off.
SELF_HEAL_HISTORY=1
